# Optional: Used for live AWS audits (`--mode aws`).
# Prefer IAM Identity Center SSO, OIDC federation, or an IAM Role over static keys.
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=readonly-auditor
# Optional cross-account role assumption
# AWS_AUDIT_ROLE_ARN=arn:aws:iam::123456789012:role/SecurityCostAuditReadOnly
